// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  nickname     String   @default("")
  phone        String   @default("")
  passwordHash String
  role         String   @default("USER") // USER | ADMIN
  status       String   @default("ACTIVATED") // PENDING_ACTIVATION | ACTIVATED
  createdAt    DateTime @default(now())
  forms        Form[]
  collaborations FormCollaborator[]
  auditLogs    AuditLog[]
}

model Form {
  id          String     @id @default(uuid())
  title       String
  description String     @default("")
  published   Boolean    @default(false)
  shortCode   String?    @unique
  collectPhone Boolean   @default(true) // Whether to collect phone number for edits
  phoneDescription String @default("We need to keep your phone number for future reference")
  phoneTitle       String @default("Phone Number")
  phonePlaceholder String @default("Enter your phone number")
  theme        String   @default("{}") // JSON string for form theme customization
  notifyEmails String   @default("") // Comma-separated emails to notify on submission
  autoSubmit   Boolean  @default(false) // Auto-submit after last section completed (5s countdown)
  authorId    String
  author      User       @relation(fields: [authorId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  sections       Section[]
  questions      Question[]
  responses      Response[]
  collaborators  FormCollaborator[]
  registeredUserData  RegisteredUserData?
}

model Section {
  id            String   @id @default(uuid())
  formId        String
  form          Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  title         String   @default("Untitled Section")
  description   String   @default("")
  order         Int      @default(0)
  routingConfig String   @default("{}") // JSON: { defaultRoute: "NEXT" | "SUBMIT" | sectionId }
  questions     Question[]
}

model Question {
  id         String   @id @default(uuid())
  formId     String
  form       Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  sectionId  String?
  section    Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  type       String   // SHORT_TEXT, PARAGRAPH, MULTIPLE_CHOICE, CHECKBOX, DROPDOWN, FILE_UPLOAD, LINEAR_SCALE, RATING, MULTIPLE_CHOICE_GRID, CHECKBOX_GRID, DATE, TIME
  label      String
  isRequired Boolean  @default(false)
  order      Int
  options    Option[]
  answers    Answer[]

  // For LINEAR_SCALE: min/max labels stored as config JSON
  // For GRID types: row/column labels stored in options with a "group" field
  config     String   @default("{}") // JSON string for extra config. Routing rules stored here as "routing" key.

  @@index([formId])
}

model Option {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value      String
  order      Int
  group      String   @default("default") // "default" for regular options, "row"/"column" for grids

  @@index([questionId])
}

model Response {
  id          String   @id @default(uuid())
  formId      String
  form        Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  shortCode   String
  phoneNumber String?  // Optional, only collected if form.collectPhone is true
  editToken   String   @unique @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  answers     Answer[]

  @@unique([formId, shortCode])
  @@index([formId])
}

model Answer {
  id         String   @id @default(uuid())
  responseId String
  response   Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value      String   @default("") // JSON string for complex answers (grids, checkboxes, etc.)

  @@index([responseId])
  @@index([questionId])
  @@index([questionId, responseId])
}

model FormCollaborator {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  formId    String
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  role      String   @default("EDITOR") // EDITOR
  createdAt DateTime @default(now())

  @@unique([userId, formId])
}

model VerificationToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  type      String   // INVITATION | PASSWORD_RESET
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // USER_INVITED, USER_DELETED, PASSWORD_CHANGED, COLLABORATOR_ADDED, COLLABORATOR_REMOVED, LOGIN, etc.
  details   String   @default("") // JSON string with extra context
  ipAddress String   @default("")
  userAgent String   @default("")
  createdAt DateTime @default(now())
}

model RegisteredUserData {
  id           String   @id @default(uuid())
  formId       String   @unique
  form         Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  headers      String   @default("[]")   // JSON array of column names
  rows         String   @default("[]")   // JSON array of row objects
  lookupColumn     String   @default("")     // Column name used for lookup matching
  lookupQuestionId String   @default("")     // Question ID that serves as the lookup key input
  secondaryLookupColumn     String @default("")  // Optional second column for verification (anti-brute-force)
  secondaryLookupQuestionId String @default("")  // Question ID for the secondary verification input
  mappings         String   @default("{}")   // JSON: { questionId: columnName }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MessagingConfig {
  id              String   @id @default(uuid())
  enabled         Boolean  @default(false)
  provider        String   @default("TzuChiWABI") // provider label
  apiBaseUrl      String   @default("")            // e.g. https://wabiwebhook.tzuchi.com.my
  apiPort         Int      @default(441)
  apiPath         String   @default("/api/sendMessage")
  tokenId         String   @default("")            // secret – masked in UI
  sender          String   @default("WhatsApp")    // WhatsApp | SmsModem | SmsGateway | Email
  requestTimeout  Int      @default(10000)         // ms
  maxRetries      Int      @default(3)
  tlsVerify       Boolean  @default(true)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

model SmtpConfig {
  id        String   @id @default(uuid())
  host      String
  port      Int      @default(587)
  secure    Boolean  @default(false)
  user      String
  pass      String
  fromEmail String
  fromName  String   @default("Form Builder")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
